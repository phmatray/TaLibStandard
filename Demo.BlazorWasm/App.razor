@using Demo.BlazorWasm.Services
@implements IDisposable
@inject ThemeState Theme

<MudThemeProvider Theme="@_theme" IsDarkMode="@Theme.IsDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)"/>
        <FocusOnNavigate RouteData="@routeData" Selector="h1"/>
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <div class="section">
                <h1>No page at this address</h1>
                <p class="lede">
                    Check the address, or start from the <a href="">overview</a>.
                </p>
            </div>
        </LayoutView>
    </NotFound>
</Router>

@code {
    // Mirrors wwwroot/css/app.css so MudBlazor components on the inner pages sit in the same
    // palette as the shell instead of shipping Material's defaults next to it.
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#b85c00",
            Secondary = "#0f6b54",
            Error = "#a32c1c",
            Success = "#0f6b54",
            Background = "#eef1f4",
            Surface = "#ffffff",
            DrawerBackground = "#ffffff",
            AppbarBackground = "#eef1f4",
            AppbarText = "#0d1317",
            TextPrimary = "#0d1317",
            TextSecondary = "#5b6a75",
            ActionDefault = "#5b6a75",
            Divider = "#cdd7df",
            LinesDefault = "#cdd7df",
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#f0921f",
            Secondary = "#2fa98a",
            Error = "#e0563d",
            Success = "#2fa98a",
            Background = "#0c1115",
            Surface = "#131b21",
            DrawerBackground = "#131b21",
            AppbarBackground = "#0c1115",
            AppbarText = "#e7eef3",
            TextPrimary = "#e7eef3",
            TextSecondary = "#93a5b2",
            ActionDefault = "#93a5b2",
            Divider = "#223039",
            LinesDefault = "#223039",
        },
        Typography = new Typography
        {
            Default = new DefaultTypography { FontFamily = ["Archivo", "Helvetica Neue", "sans-serif"] },
            Button = new ButtonTypography { FontFamily = ["IBM Plex Mono", "monospace"], TextTransform = "none" },
            Caption = new CaptionTypography { FontFamily = ["IBM Plex Mono", "monospace"] },
        },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "7px" },
    };

    protected override void OnInitialized()
    {
        Theme.Changed += OnThemeChanged;
    }

    private void OnThemeChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Theme.Changed -= OnThemeChanged;
    }
}
