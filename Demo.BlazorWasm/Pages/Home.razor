@page "/"
@using Demo.BlazorWasm.Components
@inject IJSRuntime Js

<PageTitle>TaLibStandard — technical analysis for .NET</PageTitle>

<section class="hero">
        <div>
            <p class="eyebrow">Technical analysis for .NET</p>

            <h1>Every indicator, and the <em>exact bar</em> it starts on.</h1>

            <p class="lede">
                A C# port of TA-Lib with 159 entry points, generic math across
                <span class="mono">double</span>, <span class="mono">float</span> and
                <span class="mono">decimal</span>, and an output contract precise enough to line
                up against your price series without guesswork.
            </p>

            <div class="install">
                <code><span class="dim">$</span> dotnet add package Atypical.TechnicalAnalysis</code>
                <button type="button" class="copy-btn" @onclick="Copy">@_copyLabel</button>
            </div>

            <div class="hero-links">
                <a href="indicators">Try an indicator</a>
                <a href="https://github.com/phmatray/TaLibStandard/blob/dev/docs/guides/getting-started.md">Getting started</a>
                <a href="https://github.com/phmatray/TaLibStandard">Source</a>
            </div>
        </div>

        <LookbackFigure />
    </section>

    <section class="section">
        <div class="section-head">
            <h2>What it covers</h2>
            <span class="count">159 entry points</span>
        </div>

        <div class="grid">
            <div class="cell">
                <span class="n">98</span>
                <h3>Indicator functions</h3>
                <p>
                    Moving averages, oscillators, volatility, volume, cycle and statistics — the
                    full TA-Lib function set, ported and covered by tests.
                </p>
            </div>
            <div class="cell">
                <span class="n">61</span>
                <h3>Candlestick patterns</h3>
                <p>
                    Doji through Three Line Strike, each returning a signed score per bar so you
                    can act on direction rather than a boolean.
                </p>
            </div>
            <div class="cell">
                <span class="n">3</span>
                <h3>Numeric types</h3>
                <p>
                    Generic math runs the same pattern code over <span class="mono">double</span>,
                    <span class="mono">float</span> or <span class="mono">decimal</span> without a cast.
                </p>
            </div>
            <div class="cell">
                <span class="n">0</span>
                <h3>Native dependencies</h3>
                <p>
                    Managed end to end, so it runs anywhere .NET runs — including in this page,
                    compiled to WebAssembly.
                </p>
            </div>
        </div>
    </section>

    <section class="section">
        <div class="section-head">
            <h2>Explore</h2>
        </div>

        <div class="grid">
            <a class="cell" href="indicators">
                <span class="k">Indicators</span>
                <h3>Compute and plot</h3>
                <p>Pick an indicator and a period, then see the result over a price series.</p>
            </a>
            <a class="cell" href="candlesticks">
                <span class="k">Patterns</span>
                <h3>Detect candlesticks</h3>
                <p>Run pattern recognition across a series and mark every hit on the chart.</p>
            </a>
            <a class="cell" href="analysis">
                <span class="k">Analysis</span>
                <h3>Combine signals</h3>
                <p>Layer several indicators over one instrument and read them together.</p>
            </a>
            <a class="cell" href="math">
                <span class="k">Math</span>
                <h3>Transform series</h3>
                <p>The arithmetic and trigonometric helpers the indicators are built from.</p>
            </a>
        </div>
    </section>

@code {
    private string _copyLabel = "Copy";

    private async Task Copy()
    {
        bool copied = await Js.InvokeAsync<bool>("taLib.copy", "dotnet add package Atypical.TechnicalAnalysis");
        _copyLabel = copied ? "Copied" : "Press ⌘C";
        StateHasChanged();

        await Task.Delay(1600);
        _copyLabel = "Copy";
        StateHasChanged();
    }
}
